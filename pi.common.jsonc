{
  // ----------------------------------------------------------------------------------
  // Shared Pi settings. Model selections come from the selected preset.
  // The Orchestrator must not run shell commands; subagents receive their own
  // `--tools` allowlist from agents/*.md and are not affected by this setting.
  "defaultTools": [
    "read",
    "grep",
    "find",
    "ls",
    "edit",
    "write",
  ],
}
