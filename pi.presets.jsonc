{
  // ----------------------------------------------------------------------------------
  // The default preset
  "default": {
    "extends": ["p-deepseek"],
  },
  // ----------------------------------------------------------------------------------
  // Pure OpenAI / ChatGPT
  "p-openai": {
    "model": "openai/gpt-6.1-sol",
    "thinkingLevel": "medium",
    "agent": {
      "Solo": {
        "model": "openai/gpt-6.1-sol",
        "thinkingLevel": "medium",
      },
      "Junior": {
        "model": "openai/gpt-6-luna",
        "thinkingLevel": "xhigh",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // OpenAI + OpenCode Go (DeepSeek)
  "p-openai-go": {
    "extends": ["p-openai"],
    "agent": {
      "Junior": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinkingLevel": "high",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Pure DeepSeek
  "p-deepseek": {
    "model": "opencode-go/deepseek-v4.1-flash",
    "thinkingLevel": "max",
    "agent": {
      "Solo": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinkingLevel": "max",
      },
      "Junior": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinkingLevel": "high",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Mistral / GLM
  "p-mistral-glm": {
    "model": "mistral/zai-glm-5-3",
    "thinkingLevel": "max",
    "agent": {
      "Solo": {
        "model": "mistral/zai-glm-5-3",
        "thinkingLevel": "max",
      },
      "Junior": {
        "model": "mistral/zai-glm-5-3-flash",
        "thinkingLevel": "max",
      },
    },
  },
  // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
  // Presets meant for usage inside of a Docker container.
  // Pi's MCP servers are local commands, so they need no Docker-specific
  // rewrites; this base mirrors the cross-harness preset structure.
  // ----------------------------------------------------------------------------------
  "w-common": {
    "common": true,
  },
  // ----------------------------------------------------------------------------------
  // GitHub Copilot
  "w-copilot": {
    "extends": ["w-common"],
    "model": "github-copilot/claude-sonnet-5",
    "thinkingLevel": "medium",
    "agent": {
      "Solo": {
        "model": "github-copilot/claude-sonnet-5",
        "thinkingLevel": "medium",
      },
      "Junior": {
        "model": "github-copilot/gpt-5.3-codex",
        "thinkingLevel": "medium",
      },
    },
  },
  "w-openai": {
    "extends": ["w-common", "p-openai"],
  },
  "w-openai-go": {
    "extends": ["w-common", "p-openai-go"],
  },
  "w-mistral-glm": {
    "extends": ["w-common", "p-mistral-glm"],
  },
  "w-deepseek": {
    "extends": ["w-common", "p-deepseek"],
  },
}
